# ashareapi 容器 —— MCP 服务器 + 本地网关
#
# ⚠️ 镜像里只有**客户端代码**（mcp_ashare.py + entrypoint.py）：
#     所有数据都来自 ASHARE_API（https://api.ashareapi.com），需要 Key 才能取到。
#     ⛔ 不打包任何数据源 —— 与 PyPI / npm 上的包同样只读。
#
# 在 ashareapi-mcp/ 下构建：
#   docker build -f docker/Dockerfile.dockerhub -t ashareapi/mcp .
#
# 运行：
#   docker run -i --rm -e ASHARE_KEY=ct-xxx ashareapi/mcp              # MCP（stdio）
#   docker run -p 8080:8080 -e ASHARE_KEY=ct-xxx ashareapi/mcp gateway # 网关

FROM python:3.12-slim

LABEL org.opencontainers.image.title="ashareapi MCP"
LABEL org.opencontainers.image.description="A-Share data API - MCP server & local gateway. Data served remotely; bring your own key."
LABEL org.opencontainers.image.source="https://github.com/ashareapi/ashareapi-mcp"
LABEL org.opencontainers.image.url="https://ashareapi.com/mcp"
LABEL org.opencontainers.image.licenses="MIT"
# 官方 MCP Registry 要求：镜像必须声明它对应哪个 server.json 条目
LABEL io.modelcontextprotocol.server.name="com.ashareapi/ashare-data-api"

WORKDIR /app

# ⚠️ 只装客户端所需依赖（MCP 协议 + HTTP），不装任何数据层
RUN pip install --no-cache-dir "mcp>=1.0" "requests>=2.28" "httpx>=0.27" "fastapi>=0.110" "uvicorn>=0.29"

# ⚠️ 只复制两个文件 —— 不要 `COPY . .`，否则数据/备份会被打进镜像
COPY mcp_ashare.py /app/mcp_ashare.py
COPY docker/entrypoint.py /app/entrypoint.py

ENV ASHARE_API=https://api.ashareapi.com \
    PYTHONUNBUFFERED=1
EXPOSE 8080

ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["mcp"]
